# CommandOps Production Environment Template

# Application
NEXT_PUBLIC_APP_URL="https://commandops.yourdomain.com"
NODE_ENV="production"

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@postgres-host:5432/commandops_db?sslmode=require"

# Authentication & Session Secrets
JWT_SECRET="your_production_jwt_signing_secret_minimum_32_chars"
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD=""

# Discord Application Credentials (From Discord Developer Portal)
DISCORD_CLIENT_ID="your_discord_client_id"
DISCORD_BOT_TOKEN="your_discord_bot_token"
DISCORD_PUBLIC_KEY="your_64_character_ed25519_public_key"
DISCORD_GUILD_ID="your_discord_guild_id"

# Webhook Mirror Notification Delivery
DEFAULT_MIRROR_WEBHOOK_URL="https://discord.com/api/webhooks/your_webhook_id/your_token"

# AI Provider Configuration (Google Gemini)
GEMINI_API_KEY=""

# Production Flags
DEMO_MODE="false"
