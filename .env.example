# CommandOps Environment Variables Template

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (PostgreSQL / Neon)
# Local Docker or Neon PostgreSQL URL
DATABASE_URL="postgresql://commandops:commandops123@localhost:5432/commandops_db?schema=public"

# Auth Secret (JWT Signing)
JWT_SECRET="your-super-secret-jwt-token-key-change-in-production-min-32-chars"
ADMIN_EMAIL="admin@commandops.io"
ADMIN_PASSWORD="admin_password_123!"

# Discord Application Credentials (From Discord Developer Portal)
DISCORD_CLIENT_ID="123456789012345678"
DISCORD_BOT_TOKEN="your_discord_bot_token_here"
DISCORD_PUBLIC_KEY="8a3498b5a0...ed25519_hex_public_key_64_chars..."
DISCORD_GUILD_ID="987654321098765432"

# Primary Notification Webhook (Discord / Slack Mirror Webhook)
DEFAULT_MIRROR_WEBHOOK_URL="https://discord.com/api/webhooks/123456789/xxxx-xxxx-xxxx"

# AI Provider Configuration (Google Gemini / Fallback)
# Optional: If not provided, CommandOps gracefully switches to Fallback Heuristic AI Provider.
GEMINI_API_KEY=""

# Feature Flags & Demo Mode
DEMO_MODE="true"
